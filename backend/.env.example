# SkillChain Backend Configuration
# Database Connection: By default sqlite is used for instant zero-config evaluation.
# To connect to MySQL: mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/skillchain_db
DATABASE_URL=sqlite:///./skillchain.db

# JWT Security
JWT_SECRET=skillchain-ultra-secure-jwt-secret-key-2026-prod-college
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Blockchain Settings (Hardhat Localhost)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Default Hardhat local node Account #0 private key
ISSUER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# AI Intelligence
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DEMO_MODE=true

# Frontend URL
FRONTEND_URL=http://localhost:5173
